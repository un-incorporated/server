project_id         = "my-gcp-project"
region             = "us-west1"
zone               = "us-west1-a"

db_name            = "uninc"
db_user            = "uninc_admin"
db_password        = "CHANGE-ME-strong-password"

replica_count      = 5
proxy_machine_type = "e2-standard-4"
db_machine_type    = "e2-standard-2"

# Per-role baked GCE images. Empty gce_image_version follows the
# image_family head — fine for dev, pin to a release tag for prod.
# Images live on GitHub Releases and need to be imported into this
# project before `terraform apply`. One-liner per role:
#   gcloud compute images create uninc-proxy-v0-1-3 \
#     --source-uri=gs://YOUR_BUCKET/uninc-proxy-v0-1-3.tar.gz \
#     --project=$PROJECT_ID
# (Where the gs:// object is the tar.gz from the GitHub Release —
# `gsutil cp https://...github.com/.../uninc-proxy-v0-1-3.tar.gz gs://...`)
gce_image_version  = "v0.1.3"

# Caddy on_demand_tls. ask_url_with_secret can stay empty for a
# proxy-only deployment (no Cloud Run app, no end-user web traffic).
admin_email          = "admin@example.com"
ask_url_with_secret  = ""

admin_ssh_cidr     = "203.0.113.0/24"
admin_emails       = ["admin@example.com", "ops@example.com"]
jwt_secret         = "CHANGE-ME-random-secret"
